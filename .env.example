# Copy this file's contents into a new file named ".env" (no ".example")
# in the project root, then fill in your real key(s) below.
# .env should NEVER be committed to git — it holds secrets.

# --- API keys (only the one matching AI_PROVIDER below actually needs a real value) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# --- Which AI provider to use ---
AI_PROVIDER=anthropic
# AI_PROVIDER=openai

# --- Which data source to use ---
# live       -> real SimplyRETS sandbox API (small, fixed, Redwood City only)
# sample     -> app/data/sample_listings.json (tiny hand-edited test set)
# realistic  -> app/data/realistic_listings.json (14 hand-written listings)
# generated  -> app/data/generated_listings.json (large generated set)
DATA_SOURCE=generated

# --- How many AI batches run at once (bigger = faster searches) ---
# Don't guess this — watch the "[provider rate limits] ... remaining" lines
# this app prints to your terminal during a search. Lots of headroom left
# with zero retries? Raise this (try 8, then 12, etc.) and re-check. If you
# see "[rate limit] Hit 429, retrying..." lines, you've gone too high.
MAX_CONCURRENT_BATCHES=4

# --- Optional tuning (defaults shown) ---
# BATCH_SIZE=8
# SCORE_THRESHOLD=60
# TEMPERATURE=0.2
# MAX_TOKENS=2000
# CORS_ALLOW_ORIGINS=*
